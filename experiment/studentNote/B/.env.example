# Copy to .env (never commit .env).

PORT=3000
HOST=127.0.0.1
DB_PATH=./data/notes.db

# Set to true whenever the app is served over HTTPS (defaults to true when NODE_ENV=production).
COOKIE_SECURE=false
SESSION_TTL_MINUTES=60

# Number of reverse proxies in front of the app (leave unset when there are none).
# TRUST_PROXY=1

# Only read by `npm run seed-admin`. Choose your own values; there are no defaults.
ADMIN_USERNAME=
ADMIN_PASSWORD=
